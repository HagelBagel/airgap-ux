{
  "name": "sovereign-jtbd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "code-quality": "npm run type-check && npm run lint-check && npm run test && npm run unused-check",
    "code-quality:fix": "npm run lint-fix && npm run type-check",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit",
    "lint-check": "eslint src/ --max-warnings 0",
    "lint-fix": "eslint src/ --fix",
    "unused-check": "npm run lint-check"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@xenova/transformers": "^2.17.2",
    "idb": "^8.0.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.6",
    "wavesurfer.js": "^7.12.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "jsdom": "^29.1.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7",
    "workbox-window": "^7.4.0"
  }
}
