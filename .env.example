# Copy to .env (`cp .env.example .env`) and adjust. .env is gitignored, so
# real secrets never get committed; this file holds only local dev defaults.
# The password below matches compose.yaml and only works on 127.0.0.1.

# App: return canned analysis results instead of downloading a model.
VITE_MOCK_MODE=true

# Dev database (dbmate, server/)
DATABASE_URL=postgres://airgap:devpassword@127.0.0.1:5432/airgap?sslmode=disable
# Test database for server/ API tests (`npm run db:test:prepare` creates it)
TEST_DATABASE_URL=postgres://airgap:devpassword@127.0.0.1:5432/airgap_test?sslmode=disable

# Stands in for the signed-in User until sign-in exists. Must match the user in
# db/seed.sql. The API refuses to start with this set and NODE_ENV=production.
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# API_PORT=3001
